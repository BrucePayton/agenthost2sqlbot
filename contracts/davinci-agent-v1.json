    {"action":"dashboard.copy_widget","version":"1.0","executor":"frontend","risk":"changeset","contextEffect":"mutates","bundle":"dashboard-edit","sdkToolName":"dashboard__copy_widget","description":"Prepare a ChangeSet that copies a widget.","inputTemplate":"copyWidget","outputTemplate":"changeSet","public":true},
