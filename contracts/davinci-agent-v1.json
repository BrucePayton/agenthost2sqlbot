{
  "contractVersion": "1.0",
  "protocolVersion": "1.0",
  "schemaTemplates": {
    "empty": {"type": "object", "properties": {}, "additionalProperties": false},
    "dashboardRef": {"type": "object", "properties": {"dashboardId": {"type": "string", "minLength": 1, "maxLength": 100}}, "required": ["dashboardId"], "additionalProperties": false},
    "widgetRef": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}}, "required": ["widgetId"], "additionalProperties": false},
    "datasetRef": {"type": "object", "properties": {"datasetType": {"type": "string", "enum": ["VIEW", "SQL", "CUSTOM"]}, "datasetUid": {"type": "string", "minLength": 1, "maxLength": 100}}, "required": ["datasetType", "datasetUid"], "additionalProperties": false},
    "query": {"type": "object", "properties": {"query": {"type": "string", "minLength": 1, "maxLength": 200}}, "required": ["query"], "additionalProperties": false},
    "optionalQuery": {"type": "object", "properties": {"query": {"type": "string", "maxLength": 200}}, "additionalProperties": false},
    "filterValues": {"type": "object", "properties": {"values": {"type": "array", "maxItems": 20, "items": {"type": "object", "properties": {"filterId": {"type": "string", "minLength": 1, "maxLength": 100}, "value": {"type": ["string", "number", "boolean", "null"]}}, "required": ["filterId", "value"], "additionalProperties": false}}}, "required": ["values"], "additionalProperties": false},
    "filterIds": {"type": "object", "properties": {"filterIds": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 100}}}, "additionalProperties": false},
    "marketplaceFilters": {"type": "object", "properties": {"scope": {"type": "string", "enum": ["all", "mine", "shared"]}, "datasetType": {"type": "string", "enum": ["all", "VIEW", "SQL", "CUSTOM"]}, "businessSystemId": {"type": "string", "maxLength": 100}, "owner": {"type": "string", "maxLength": 100}, "source": {"type": "string", "maxLength": 100}}, "additionalProperties": false},
    "datasetSelection": {"type": "object", "properties": {"datasets": {"type": "array", "maxItems": 50, "items": {"type": "object", "properties": {"datasetType": {"type": "string", "enum": ["VIEW", "SQL", "CUSTOM"]}, "datasetUid": {"type": "string", "minLength": 1, "maxLength": 100}}, "required": ["datasetType", "datasetUid"], "additionalProperties": false}}}, "required": ["datasets"], "additionalProperties": false},
    "relatedDashboard": {"type": "object", "properties": {"dashboardId": {"type": "string", "minLength": 1, "maxLength": 100}, "datasetType": {"type": "string", "maxLength": 64, "description": "Marketplace dataset type, the <type> part of datasetRef: warehouseTopic | widget | warehouseTable | personalTempTable | certifiedManualTable | selfBuiltDataset."}, "datasetUid": {"type": "string", "minLength": 1, "maxLength": 100}}, "required": ["dashboardId", "datasetType", "datasetUid"], "additionalProperties": false},
    "editorOpen": {"type": "object", "properties": {"mode": {"type": "string", "enum": ["create", "edit"]}, "datasetUid": {"type": "string", "maxLength": 100}}, "required": ["mode"], "additionalProperties": false},
    "sourceIds": {"type": "object", "properties": {"sourceIds": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 100}}}, "required": ["sourceIds"], "additionalProperties": false},
    "sourceRef": {"type": "object", "properties": {"sourceId": {"type": "string", "minLength": 1, "maxLength": 100}}, "required": ["sourceId"], "additionalProperties": false},
    "tableConfig": {"type": "object", "properties": {"sourceId": {"type": "string", "minLength": 1, "maxLength": 100}, "fields": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 100}}, "filters": {"type": "array", "maxItems": 20, "items": {"type": "object", "properties": {"fieldId": {"type": "string", "minLength": 1, "maxLength": 100}, "operator": {"type": "string", "maxLength": 40}, "value": {"type": ["string", "number", "boolean", "null"]}}, "required": ["fieldId", "operator"], "additionalProperties": false}}}, "required": ["sourceId", "fields", "filters"], "additionalProperties": false},
    "joinCandidates": {"type": "object", "properties": {"leftSourceId": {"type": "string", "minLength": 1, "maxLength": 100}, "rightSourceId": {"type": "string", "minLength": 1, "maxLength": 100}}, "required": ["leftSourceId", "rightSourceId"], "additionalProperties": false},
    "relationConfig": {"type": "object", "properties": {"sourceId": {"type": "string", "minLength": 1, "maxLength": 100}, "joinType": {"type": "string", "enum": ["left", "inner"]}, "leftKey": {"type": "string", "minLength": 1, "maxLength": 100}, "rightKey": {"type": "string", "minLength": 1, "maxLength": 100}, "fields": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 100}}, "filters": {"type": "array", "maxItems": 20, "items": {"type": "object", "properties": {"fieldId": {"type": "string", "minLength": 1, "maxLength": 100}, "operator": {"type": "string", "maxLength": 40}, "value": {"type": ["string", "number", "boolean", "null"]}}, "required": ["fieldId", "operator"], "additionalProperties": false}}}, "required": ["sourceId", "joinType", "leftKey", "rightKey", "fields", "filters"], "additionalProperties": false},
    "preview": {"type": "object", "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 100}}, "additionalProperties": false},
    "metadata": {"type": "object", "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 100}, "description": {"type": "string", "maxLength": 500}, "businessSystemId": {"type": "string", "maxLength": 100}}, "required": ["name"], "additionalProperties": false},
    "addWidget": {"type": "object", "properties": {"widgetType": {"type": "string", "enum": ["metric", "chart", "table", "pivot", "iframe"]}, "title": {"type": "string", "maxLength": 200}}, "required": ["widgetType"], "additionalProperties": false},
    "copyWidget": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "title": {"type": "string", "maxLength": 200}}, "required": ["widgetId"], "additionalProperties": false},
    "renameWidget": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "title": {"type": "string", "minLength": 1, "maxLength": 200}}, "required": ["widgetId", "title"], "additionalProperties": false},
    "widgetLayout": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1, "maximum": 24}, "height": {"type": "integer", "minimum": 1, "maximum": 100}}, "required": ["widgetId", "x", "y", "width", "height"], "additionalProperties": false},
    "widgetChart": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "chartType": {"type": "string", "enum": ["line", "bar", "area", "pie", "scatter", "table", "pivot", "metric"]}}, "required": ["widgetId", "chartType"], "additionalProperties": false},
    "widgetFields": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "dimensions": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 100}}, "metrics": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 100}}}, "required": ["widgetId", "dimensions", "metrics"], "additionalProperties": false},
    "widgetFilters": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "filters": {"type": "array", "maxItems": 20, "items": {"type": "object", "properties": {"fieldId": {"type": "string", "minLength": 1, "maxLength": 100}, "operator": {"type": "string", "maxLength": 40}, "value": {"type": ["string", "number", "boolean", "null"]}}, "required": ["fieldId", "operator"], "additionalProperties": false}}}, "required": ["widgetId", "filters"], "additionalProperties": false},
    "widgetSort": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "sorts": {"type": "array", "maxItems": 10, "items": {"type": "object", "properties": {"fieldId": {"type": "string", "minLength": 1, "maxLength": 100}, "direction": {"type": "string", "enum": ["asc", "desc"]}}, "required": ["fieldId", "direction"], "additionalProperties": false}}}, "required": ["widgetId", "sorts"], "additionalProperties": false},
    "widgetStyle": {"type": "object", "properties": {"widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "titleVisible": {"type": "boolean"}, "legendVisible": {"type": "boolean"}, "colorScheme": {"type": "string", "maxLength": 50}}, "required": ["widgetId"], "additionalProperties": false},
    "snapshotWidget": {"type": "object", "properties": {"snapshotRef": {"type": "string", "minLength": 1, "maxLength": 200}, "widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "offset": {"type": "integer", "minimum": 0, "maximum": 10000}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}, "fields": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 100}}}, "required": ["snapshotRef", "widgetId"], "additionalProperties": false},
    "summary": {"type": "object", "properties": {"summary": {"type": "string", "maxLength": 2000}, "contextVersion": {"type": "integer", "minimum": 0}}, "required": ["summary"], "additionalProperties": false},
    "widgetData": {"type": "object", "properties": {"summary": {"type": "string", "maxLength": 2000}, "widgetId": {"type": "string", "minLength": 1, "maxLength": 100}, "title": {"type": "string", "maxLength": 200}, "fields": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 100}}, "rows": {"type": "array", "maxItems": 100, "items": {"type": "array", "maxItems": 50, "items": {"type": ["string", "number", "boolean", "null"]}}}, "offset": {"type": "integer", "minimum": 0}, "returnedRows": {"type": "integer", "minimum": 0, "maximum": 100}, "truncated": {"type": "boolean"}, "contextVersion": {"type": "integer", "minimum": 0}}, "required": ["summary", "widgetId", "title", "fields", "rows", "offset", "returnedRows"], "additionalProperties": false},
    "operation": {"type": "object", "properties": {"status": {"type": "string", "enum": ["executed", "opened", "refreshed", "focused", "closed"]}, "contextVersion": {"type": "integer", "minimum": 0}, "summary": {"type": "string", "maxLength": 1000}}, "required": ["status", "contextVersion"], "additionalProperties": false},
    "artifact": {"type": "object", "properties": {"snapshotRef": {"type": "string", "minLength": 1, "maxLength": 200}, "summary": {"type": "string", "maxLength": 2000}, "partialErrors": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 300}}}, "required": ["snapshotRef", "summary", "partialErrors"], "additionalProperties": false},
    "changeSet": {"type": "object", "properties": {"phase": {"type": "string", "enum": ["preview", "prepared"]}, "changeSetId": {"type": "string", "maxLength": 200}, "summary": {"type": "string", "maxLength": 2000}}, "required": ["phase", "summary"], "additionalProperties": false},
    "draft": {"type": "object", "properties": {"phase": {"type": "string", "enum": ["applied", "prepared"]}, "draftHash": {"type": "string", "minLength": 1, "maxLength": 128}, "impactRef": {"type": "string", "maxLength": 200}, "summary": {"type": "string", "maxLength": 2000}}, "required": ["phase", "draftHash", "summary"], "additionalProperties": false},
    "save": {"type": "object", "properties": {"resourceRef": {"type": "string", "minLength": 1, "maxLength": 200}, "revision": {"type": "string", "minLength": 1, "maxLength": 50}, "summary": {"type": "string", "maxLength": 2000}}, "required": ["resourceRef", "revision", "summary"], "additionalProperties": false}
  },
  "tools": [
    {"action":"page.get_context","version":"1.0","executor":"frontend","risk":"read","contextEffect":"none","bundle":"core-navigation","sdkToolName":"page__get_context","description":"Get the current Davinci page, entity, permission and state summary.","inputTemplate":"empty","outputTemplate":"summary","public":true},
    {"action":"workspace.list_dashboards","version":"1.0","executor":"frontend","risk":"read","contextEffect":"none","bundle":"core-navigation","sdkToolName":"workspace__list_dashboards","description":"List dashboards visible in the current workspace or space menu (name, dashboardId, source V1/V2, space). Use its dashboardId for ui.open_dashboard. Optional query filters by name or id; at most 30 are shown.","inputTemplate":"optionalQuery","outputTemplate":"summary","public":true},
    {"action":"ui.open_dashboard","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"core-navigation","sdkToolName":"ui__open_dashboard","description":"Open one dashboard visible in the current workspace or space menu by its dashboardId taken from workspace.list_dashboards. Inside a collaborative space only that space's dashboards can be opened; use ui.open_personal_workspace first for personal dashboards. Navigates and changes the tool catalog.","inputTemplate":"dashboardRef","outputTemplate":"operation","public":true},
    {"action":"ui.open_dataset_marketplace","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"core-navigation","sdkToolName":"ui__open_dataset_marketplace","description":"Open the dataset marketplace (数据集市). After navigation the catalog switches to the dataset tools: search and inspect datasets, and open the self-built dataset editor to join datasets for a widget or a subscription. Use it when the user wants to browse datasets or build a joined dataset; for finding fields by business term use the davinci_data catalog tools instead.","inputTemplate":"empty","outputTemplate":"operation","public":true},
    {"action":"dashboard.get_structure","version":"1.0","executor":"frontend","risk":"read","contextEffect":"none","bundle":"dashboard-observe","sdkToolName":"dashboard__get_structure","description":"Return the dashboard's widget list (widgetId, title, type, layout) as text. The same content arrives as the dashboard_structure context item every turn; call only when that item is missing or resourceRevision changed.","inputTemplate":"empty","outputTemplate":"summary","public":true},
    {"action":"dashboard.get_filters","version":"1.0","executor":"frontend","risk":"read","contextEffect":"none","bundle":"dashboard-observe","sdkToolName":"dashboard__get_filters","description":"List the dashboard's global filters as text: name[filterId]=current values. Supplies the filterId required by dashboard.set_filter_values and clear_filter_values.","inputTemplate":"empty","outputTemplate":"summary","public":true},
    {"action":"dashboard.get_widget_config","version":"1.0","executor":"frontend","risk":"read","contextEffect":"none","bundle":"dashboard-observe","sdkToolName":"dashboard__get_widget_config","description":"Get a bounded widget configuration summary.","inputTemplate":"widgetRef","outputTemplate":"summary","public":true},
    {"action":"dashboard.capture_current_view","version":"1.0","executor":"frontend","risk":"read","contextEffect":"none","bundle":"dashboard-observe","sdkToolName":"dashboard__capture_current_view","description":"Capture the current filtered dashboard as a bounded snapshot. Returns an opaque snapshotRef plus current filters, widget IDs, row counts, small row samples and partial query errors in summary.","inputTemplate":"empty","outputTemplate":"artifact","public":true,"timeoutMs":75000},
    {"action":"dashboard.get_widget_data","version":"1.0","executor":"host","risk":"read","contextEffect":"none","bundle":"dashboard-observe","sdkToolName":"dashboard__get_widget_data","description":"Read bounded structured fields and rows for one widget from an explicit snapshotRef returned by dashboard.capture_current_view.","inputTemplate":"snapshotWidget","outputTemplate":"widgetData","public":true},
    {"action":"dashboard.get_errors","version":"1.0","executor":"frontend","risk":"read","contextEffect":"none","bundle":"dashboard-observe","sdkToolName":"dashboard__get_errors","description":"List current widget query errors and dataset field errors as text. Prefer dashboard.get_widget_data state=error for one widget's failure; use this for a dashboard-wide overview.","inputTemplate":"empty","outputTemplate":"summary","public":true},
    {"action":"dashboard.focus_widget","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"dashboard__focus_widget","description":"Focus and select a widget.","inputTemplate":"widgetRef","outputTemplate":"operation","public":true},
    {"action":"dashboard.open_widget_config","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"dashboard__open_widget_config","description":"Open the selected widget configuration panel.","inputTemplate":"widgetRef","outputTemplate":"operation","public":true},
    {"action":"dashboard.close_widget_config","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"dashboard__close_widget_config","description":"Close the widget configuration panel.","inputTemplate":"empty","outputTemplate":"operation","public":true},
    {"action":"dashboard.open_filter_panel","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"dashboard__open_filter_panel","description":"Open the dashboard filter panel.","inputTemplate":"empty","outputTemplate":"operation","public":true},
    {"action":"dashboard.set_filter_values","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"dashboard__set_filter_values","description":"Set runtime values on existing global filters by filterId from dashboard.get_filters. Runtime only: nothing is persisted and widgets re-query afterwards. Unknown filterId returns FILTER_NOT_FOUND without changing anything.","inputTemplate":"filterValues","outputTemplate":"operation","public":true},
    {"action":"dashboard.clear_filter_values","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"dashboard__clear_filter_values","description":"Clear runtime values of the given filterIds (from dashboard.get_filters), or of all filters when filterIds is omitted. Runtime only; nothing is persisted.","inputTemplate":"filterIds","outputTemplate":"operation","public":true},
    {"action":"dashboard.refresh_all","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"none","bundle":"dashboard-runtime","sdkToolName":"dashboard__refresh_all","description":"Refresh all widget queries without regenerating AI interpretation.","inputTemplate":"empty","outputTemplate":"operation","public":true},
