    {"action":"dashboard.exit_fullscreen","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"dashboard__exit_fullscreen","description":"Exit dashboard presentation mode.","inputTemplate":"empty","outputTemplate":"operation","public":true},
    {"action":"ui.open_share_panel","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"ui__open_share_panel","description":"Open the share panel without submitting a share.","inputTemplate":"empty","outputTemplate":"operation","public":true},
    {"action":"dashboard.open_data_push","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dashboard-runtime","sdkToolName":"dashboard__open_data_push","description":"Open the data push panel without saving.","inputTemplate":"empty","outputTemplate":"operation","public":true},
