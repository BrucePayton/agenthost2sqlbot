    {"action":"dataset.marketplace.search","version":"1.0","executor":"frontend","risk":"temporary","contextEffect":"mutates","bundle":"dataset-marketplace","sdkToolName":"dataset__marketplace__search","description":"Search datasets by keyword.","inputTemplate":"query","outputTemplate":"operation","public":true},
