                <mxCell id="gates-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#263238;" value="&lt;b&gt;C. 真实端到端验收门禁&lt;/b&gt;" vertex="1">
                    <mxGeometry height="36" width="900" x="45" y="1095" as="geometry"/>
                </mxCell>
                <mxCell id="gate-asset" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263238;fillColor=#FFEBEE;strokeColor=#D32F2F;dashed=1;dashPattern=8 4;strokeWidth=3;" value="&lt;b&gt;同源资产&lt;/b&gt;&lt;br&gt;先证明 MCP resource 与 knowledge.sync_job 是同一资产；不得用无关有权样本代替" vertex="1">
                    <mxGeometry height="140" width="680" x="45" y="1155" as="geometry"/>
                </mxCell>
                <mxCell id="gate-secret" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263238;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" value="&lt;b&gt;SQLBot SECRET_KEY&lt;/b&gt;&lt;br&gt;已取运行容器部署级 Secret 并通过临时 Assistant JWT 鉴权；API Key Secret 未混用" vertex="1">
                    <mxGeometry height="140" width="680" x="760" y="1155" as="geometry"/>
                </mxCell>
                <mxCell id="gate-network" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263238;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;" value="&lt;b&gt;双向网络&lt;/b&gt;&lt;br&gt;SQLBot 可达回调与数据库；Data Agent 可达 SQLBot 与外部 MCP" vertex="1">
                    <mxGeometry height="140" width="680" x="1475" y="1155" as="geometry"/>
                </mxCell>
                <mxCell id="gate-security" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263238;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;" value="&lt;b&gt;测试账号风险&lt;/b&gt;&lt;br&gt;高权限 MySQL 仅用于测试；只存本地环境变量；生产切换只读最小账号" vertex="1">
                    <mxGeometry height="140" width="680" x="45" y="1335" as="geometry"/>
                </mxCell>
                <mxCell id="gate-row" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263238;fillColor=#FFEBEE;strokeColor=#D32F2F;dashed=1;dashPattern=8 4;strokeWidth=3;" value="&lt;b&gt;行权限事实&lt;/b&gt;&lt;br&gt;Asset MCP 未提供基础 SQL/行谓词；非空 requiredFilters 正样本仍缺失" vertex="1">
                    <mxGeometry height="140" width="680" x="760" y="1335" as="geometry"/>
                </mxCell>
                <mxCell id="gate-failclosed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263238;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" value="&lt;b&gt;失败关闭&lt;/b&gt;&lt;br&gt;MCP 拒绝/超时、ticket 异常、schema 不一致均不得下发连接" vertex="1">
                    <mxGeometry height="140" width="680" x="1475" y="1335" as="geometry"/>
                </mxCell>
                <mxCell id="overview-boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263238;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" value="&lt;b&gt;最终边界&lt;/b&gt;&lt;br&gt;SQLBot 不得绕过 Data Agent 使用静态数据源；只有 Ticket 与外部 MCP 复核通过后，Data Agent 才返回临时连接和裁决后 Schema。随后仍由 SQLBot 执行 SQL——这是报告零改 SQLBot 的既定方案。" vertex="1">
                    <mxGeometry height="150" width="1390" x="45" y="1570" as="geometry"/>
                </mxCell>
                <mxCell id="overview-approval" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=13;fontColor=#263238;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;" value="&lt;b&gt;当前实施结论&lt;/b&gt;&lt;br&gt;SQLBot、数据库和部署 Secret 已就绪；真实 E2E 不伪造通过。当前核心阻塞仅剩同源 assetRef；行权限与回调 CIDR 仍需生产验收。" vertex="1">
                    <mxGeometry height="150" width="690" x="1470" y="1570" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
