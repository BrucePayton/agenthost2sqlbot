                <mxCell id="recovery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontColor=#263238;fillColor=#F5F5F5;strokeColor=#607D8B;strokeWidth=2;" value="&lt;b&gt;可靠性设计&lt;/b&gt;&lt;br&gt;Session 快照固定配置与 Skills；会话锁与 Memory 锁控制并发；Turn 状态区分 completed / failed / cancelled / outcome_unknown / recovery_required，无法确认结果时进入核对或恢复流程。" vertex="1">
                    <mxGeometry height="90" width="1810" x="40" y="1120" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#263238;" value="&lt;b&gt;3 / 优化建议 · 按当前问题渐进改进，不预建微服务框架&lt;/b&gt;" vertex="1">
                    <mxGeometry height="40" width="1820" x="40" y="1240" as="geometry"/>
                </mxCell>
                <mxCell id="o1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontColor=#263238;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;" value="&lt;b&gt;P1 · 收敛 Runtime 的职责&lt;/b&gt;&lt;br&gt;现状：runtime/claude.py 同时承担 SDK 适配、工具策略与订阅／布局业务控制。&lt;br&gt;建议：优先复用已有业务模块，逐步抽离业务策略；保留统一 Runtime 契约。&lt;br&gt;验收：普通对话、工具续接、订阅和布局路径行为一致，错误语义不退化。" vertex="1">
                    <mxGeometry height="185" width="580" x="40" y="1300" as="geometry"/>
                </mxCell>
                <mxCell id="o2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontColor=#263238;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;" value="&lt;b&gt;P1 · 同步文档与能力矩阵&lt;/b&gt;&lt;br&gt;现状：README 的“仅 Mock”“无 Node 构建链”等描述落后于源码。&lt;br&gt;建议：按身份模式 × 执行模式 × AG-UI × 存储模式明确支持组合与启动条件。&lt;br&gt;验收：文档、配置校验和真实启动结果一致；保留当前 AG-UI 模式限制。" vertex="1">
                    <mxGeometry height="185" width="580" x="650" y="1300" as="geometry"/>
                </mxCell>
                <mxCell id="o3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontColor=#263238;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;" value="&lt;b&gt;P1 · 把现有观测串成调用链&lt;/b&gt;&lt;br&gt;现状：已有 Request ID、事件、工具账本、耗时与 Session Inspector。&lt;br&gt;建议：统一串联 request / session / turn / tool_call，展示模型、工具往返和布局耗时。&lt;br&gt;验收：一次用户请求可追踪到实际回执与保存结果，失败能定位所在阶段。" vertex="1">
                    <mxGeometry height="185" width="590" x="1260" y="1300" as="geometry"/>
                </mxCell>
                <mxCell id="o4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontColor=#263238;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;" value="&lt;b&gt;P2 · 出现多节点需求后再补齐存储与恢复&lt;/b&gt;&lt;br&gt;现状：filesystem Artifact 与进程内 Bridge／锁限制直接横向扩容。&lt;br&gt;建议：先梳理共享会话文件、Memory、Artifact 及执行归属；有明确扩容需求时实现共享存储适配，定义 Bridge 路由／恢复策略。&lt;br&gt;验收：跨节点恢复、Skill 快照一致、Memory 并发正确；重连不重复执行写操作。" vertex="1">
                    <mxGeometry height="185" width="890" x="40" y="1510" as="geometry"/>
                </mxCell>
                <mxCell id="o5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontColor=#263238;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;" value="&lt;b&gt;持续门禁 · 保持契约与真实业务验收&lt;/b&gt;&lt;br&gt;契约：以 contracts/davinci-agent-v2.json 为唯一源；生成两端契约并构建 embed。&lt;br&gt;集成：Davinci check:agent-startup + 受影响工具真实输入／输出；确认 Bridge READY、context/session 和正常回执。&lt;br&gt;布局变更：S01–S07、真实 40 卡、完整 30 秒目标；按适用模式跑冷缓存及 3 次热缓存，保留渲染与成功保存证据。" vertex="1">
                    <mxGeometry height="185" width="890" x="960" y="1510" as="geometry"/>
                </mxCell>
                <mxCell id="s4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#263238;" value="&lt;b&gt;4 / 证据入口与范围说明&lt;/b&gt;" vertex="1">
                    <mxGeometry height="35" width="1810" x="40" y="1725" as="geometry"/>
                </mxCell>
                <mxCell id="refs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontColor=#263238;fillColor=#F5F5F5;strokeColor=#607D8B;strokeWidth=2;" value="&lt;b&gt;源码入口（相对 Agent Host 仓库）&lt;/b&gt;&lt;br&gt;组装与接入：app/main.py · app/bootstrap.py · app/auth/ · app/api/ · app/agui/&lt;br&gt;核心执行：app/sessions/service.py · app/turns/service.py · app/turns/sse_store.py · app/runtime/contracts.py · app/runtime/claude.py&lt;br&gt;环境与数据：app/workspaces/materializer.py · app/memory/scopes.py · app/db/ · app/skills/ · app/sandbox/ · app/runner/&lt;br&gt;范围：本页分析 Agent Host 内部架构；不新增或改变其他 TAB 中 Data MCP / SQLBot 的实现结论。优化项为建议，本次仅更新图文。" vertex="1">
                    <mxGeometry height="160" width="1810" x="40" y="1780" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
