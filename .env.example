ANTHROPIC_BASE_URL=https://proxy.example.com
# 二选一：标准 Anthropic 使用 API_KEY；Bearer 兼容网关使用 AUTH_TOKEN。
ANTHROPIC_API_KEY=replace-with-secret
# ANTHROPIC_AUTH_TOKEN=replace-with-bearer-token
WORKSPACES_ROOT=/absolute/path/to/claude_workspace_mvp/workspaces
CLAUDE_SKILLS_ROOT=/absolute/path/to/.claude/skills
CODEX_SECURITY_MCP_ENTRYPOINT=/absolute/path/to/codex-security/mcp/server.mjs
DATA_ANALYTICS_MCP_ENTRYPOINT=/absolute/path/to/data-analytics/mcp/server.cjs
AHS_HIVE_QUERY_MCP_ENTRYPOINT=/absolute/path/to/luxury_data/hive_query_mcp_server/server.py
CODEX_HOME=/absolute/path/to/.codex

CLAUDE_MODEL=claude-sonnet-4-6
# Optional. 逗号分隔；非空时 embed 会显示模型下拉，用户每轮可切换。
# 服务端只接受这个列表里的值，列表为空则隐藏下拉、始终用 CLAUDE_MODEL。
# CLAUDE_SELECTABLE_MODELS=qwen3.8-max,qwen3.7-max,qwen3.7-plus,qwen3.7-flash
# Optional. 思考强度默认档，取值 low/medium/high/xhigh/max，默认 medium。
# CLAUDE_DEFAULT_EFFORT=medium
# Optional. qwen3.8-max 建议从 4096 开始，再按回归时长调整。
# CLAUDE_THINKING_BUDGET_TOKENS=4096
# Claude CLI 的有效空闲超时下限是 300000ms（5 分钟）。
# CLAUDE_STREAM_IDLE_TIMEOUT_MS=420000
# Davinci 前端工具按当前页面固定常驻；不再配置 ToolSearch 或冷热工具列表。
# 每条用户请求最多 9 次组件配置写入；创建、修改和修正共用此预算。
APP_TOOL_WRITE_BUDGET=9
# 锁定 claude CLI 二进制。升级前先重跑 canary。
# CLAUDE_CLI_PATH=/opt/homebrew/bin/claude
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=/data/agent-host
# Filesystem-only artifact backend. Keep this as a child of APP_DATA_DIR on persistent storage.
SKILL_ARTIFACT_BACKEND=filesystem
SKILL_ARTIFACT_ROOT=/data/agent-host/skill-artifacts
APP_ENV=development
APP_IDENTITY_MODE=mock
# JSON array used only to bootstrap bindings for matching existing identities:
APP_SKILL_ADMIN_SUBJECTS='["mock-user"]'
# Optional cross-user, read-only database Session inspector. Keep disabled unless
# an operator-only HTTPS route is available. Password must be at least 24 chars.
# APP_SESSION_INSPECTOR_ENABLED=true
# APP_SESSION_INSPECTOR_USERNAME=inspector
# APP_SESSION_INSPECTOR_PASSWORD=replace-with-a-long-random-secret
APP_RUNTIME_MODE=local_inline
APP_RUNTIME_COHORT=local
APP_RUNTIME_IMAGE_DIGEST=local
APP_RUNTIME_PROTOCOL_VERSION=1
# Local Phase 2A only. Production continues to require execution_disabled.
# APP_RUNTIME_MODE=opensandbox_docker
# DATABASE_URL=postgresql+asyncpg://workspace:workspace@127.0.0.1:55432/workspace
# OPENSANDBOX_API_URL=http://127.0.0.1:8080
# OPENSANDBOX_API_KEY=replace-with-worker-only-secret
# OPENSANDBOX_RUNNER_IMAGE=workspace-agent-runner@sha256:<64-hex-digest>
# OPENSANDBOX_RUNNER_RUNTIME=fake
# OPENSANDBOX_ALLOWED_HOSTS='["api.anthropic.com"]'
# OPENSANDBOX_IDLE_TTL_SECONDS=300
# OPENSANDBOX_WORKER_CONCURRENCY=4
MOCK_USER_ID=mock-user
MOCK_USER_SUBJECT=mock-user
MOCK_USER_DISPLAY_NAME=Mock User
MOCK_PERSONAL_WORKSPACE_ID=example
APP_PERSONAL_WORKSPACE_TEMPLATE_ID=davinci-dashboard
MOCK_WORKSPACE_ROLES='{"example":"owner"}'

# Governed data-agent POC. Keep SQLBot and database secrets in the server-side
# environment only; never place them in a browser bundle or workspace manifest.
DATA_AGENT_ENABLED=false
DATA_AGENT_SUBJECT=159358
# SQLBot runs in Docker locally, so it must call the host through this name.
DATA_AGENT_PUBLIC_BASE_URL=http://host.docker.internal:18080
DATA_AGENT_TICKET_TTL_SECONDS=60
DATA_AGENT_MAX_TICKET_CALLBACKS=2
DATA_AGENT_RESULT_ROW_LIMIT=200
DATA_AGENT_CACHE_ROW_LIMIT=1000
DATA_AGENT_RESULT_TTL_SECONDS=600
# Comma-separated SQLBot source CIDRs. Docker Desktop local callbacks are
# observed as loopback here; re-measure this address after deployment.
DATA_AGENT_CALLBACK_CIDRS=127.0.0.1/32
ASSET_MCP_URL=https://asset-mcp.example.com/mcp
ASSET_MCP_TIMEOUT_SECONDS=15
# Must be the Asset MCP resource for the exact physical runtime table.
# DATA_AGENT_RUNTIME_ASSET_REF=warehouseTable:...
# Unit tests only. Never enable for a real integration environment.
DATA_AGENT_ALLOW_UNVERIFIED_LOCAL_DATASET=false
SQLBOT_BASE_URL=http://localhost:18000
SQLBOT_ADMIN_ACCOUNT=admin
# SQLBOT_ADMIN_PASSWORD=replace-with-secret
# Must equal the SECRET_KEY of the target SQLBot deployment for Assistant JWTs.
# SQLBOT_SECRET_KEY=replace-with-target-sqlbot-secret
SQLBOT_REQUEST_TIMEOUT_SECONDS=60
# 07D isolated StarRocks chain: keep SQLBOT_BASE_URL/SECRET_KEY pointed at
# local SQLBot, and read selected tables/fields/comments from service 2.
# The callback uses STARROCKS_* connection settings on this Host; service 2
# does not return database credentials through its catalog API.
# DATA_AGENT_PROVIDER=starrocks_poc
# DATA_AGENT_STARROCKS_MANIFEST=/app/starrocks-manifest.json
# DATA_AGENT_STARROCKS_METADATA_SOURCE=service2
# DATA_AGENT_SQLBOT_SOURCE_IDS={"dw":4,"dm":5,"rpt":6}
# SQLBOT_CATALOG_BASE_URL=http://service2.example.internal:8002
# SQLBOT_CATALOG_ADMIN_ACCOUNT=admin
# SQLBOT_CATALOG_ADMIN_PASSWORD=replace-with-secret
# STARROCKS_HOST=db.example.internal
# STARROCKS_PORT=9030
# STARROCKS_USER=readonly_user
# STARROCKS_PASSWORD=replace-with-secret
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=knowledge
# Dedicated account: SELECT on knowledge.sync_job only.
# MYSQL_READONLY_USER=sqlbot_poc_ro
# MYSQL_READONLY_PASSWORD=replace-with-random-readonly-password

# Phase 1 multi-replica control-plane profile. This profile intentionally queues
# Turns without executing Claude; Kubernetes Runner execution starts in Phase 2.
# APP_ENV=production
# APP_IDENTITY_MODE=oidc
# APP_RUNTIME_MODE=execution_disabled
# DATABASE_URL=postgresql+asyncpg://workspace:password@postgres:5432/workspace
# APP_OIDC_ISSUER=https://identity.example.com
# APP_OIDC_AUDIENCE=workspace-agent
# APP_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# APP_OIDC_JWKS_TTL_SECONDS=300
# APP_OIDC_CLOCK_SKEW_SECONDS=30
# APP_SPACE_AUTHORITY_URL=https://spaces.example.com
# APP_SPACE_AUTHORITY_TOKEN=replace-with-secret
# APP_MEMBERSHIP_PROJECTION_TTL_SECONDS=60

# UAT Phase 1 (single Agent Host instance): validate the existing Davinci
# bearer through currentUser, then keep it only in the Host process for
# user-scoped MCP calls.
# APP_ENV=uat
# APP_IDENTITY_MODE=davinci_passthrough
# APP_RUNTIME_MODE=local_inline
# Omit DATABASE_URL to use APP_DATA_DIR/app.db for single-node UAT.
# DAVINCI_API_BASE_URL=https://davinci.example.com
# DAVINCI_CURRENT_USER_PATH=/api/v3/users/currentUser
# DAVINCI_SESSION_TTL_SECONDS=3600
# DAVINCI_LOCAL_INTEGRATION=1
# DAVINCI_LOCAL_PUBLIC_ORIGIN=https://agent.example.com
# DAVINCI_LOCAL_PARENT_ORIGINS='["https://davinci.example.com"]'
# DAVINCI_DATA_MCP_URL=https://davinci-data-mcp-uat.example.com/mcp
MAX_SKILL_FILE_SIZE_MB=10
MAX_SKILL_BUNDLE_SIZE_MB=50
MAX_SKILL_FILES=200
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_TURN=5
TURN_TIMEOUT_SECONDS=900
SSE_HEARTBEAT_SECONDS=15
LOG_LEVEL=INFO
