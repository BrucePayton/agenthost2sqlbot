{
  "private": true,
  "scripts": {
    "generate:contracts": "python3 scripts/generate-davinci-contracts.py",
    "check:contracts": "python3 scripts/generate-davinci-contracts.py --check",
    "check:agui-build": "node scripts/check-agui-build.cjs",
    "build:agui": "python3 scripts/generate-davinci-contracts.py --check && esbuild web/embed/main.js --bundle --format=esm --platform=browser --outfile=app/web/static/embed.js && esbuild web/davinci-mock/main.js --bundle --format=esm --platform=browser --outfile=demo/davinci_mock/static/app.js",
    "test:js": "node --test tests/js/*.cjs",
    "build:sqlbot-charts": "node scripts/build-sqlbot-charts.cjs",
    "build:chat-markdown": "esbuild web/chat/markdown.js --bundle --format=iife --global-name=AssistantMarkdown --platform=browser --minify --outfile=app/web/static/chat-markdown.js"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@antv/g2": "5.4.8",
    "@antv/s2": "2.7.2",
    "lodash-es": "4.18.1",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.28.1"
  }
}
