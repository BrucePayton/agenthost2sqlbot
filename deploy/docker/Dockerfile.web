FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:$PATH \
    WORKSPACES_ROOT=/app/workspaces \
    APP_DATA_DIR=/var/lib/workspace-agent \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000

RUN python -m pip install --no-cache-dir uv==0.7.6 \
    && groupadd --gid 10001 workspace-agent \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin workspace-agent

WORKDIR /app
COPY pyproject.toml uv.lock README.md /app/
RUN --mount=type=cache,id=workspace-agent-uv,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY app /app/app
COPY contracts /app/contracts
COPY deploy/docker-web/workspaces /app/workspaces
RUN --mount=type=cache,id=workspace-agent-uv,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

RUN mkdir -p /var/lib/workspace-agent /tmp \
    && chown -R 10001:10001 /app /var/lib/workspace-agent \
    && chown root:root /app/workspaces \
    && chmod -R a-w /app/workspaces \
    && chmod 1777 /tmp

USER 10001:10001
CMD ["python", "-m", "app.cli"]
