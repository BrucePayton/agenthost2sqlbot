# Local Docker Web management configuration. Copying this file does not start the stack.
DOCKER_WEB_PORT=8765
DOCKER_WEB_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENSANDBOX_ALLOWED_HOSTS=api.anthropic.com
OPENSANDBOX_IDLE_TTL_SECONDS=300
OPENSANDBOX_SANDBOX_TIMEOUT_SECONDS=14400
OPENSANDBOX_WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_STALE_SECONDS=15

# Used only when the launcher is invoked with --claude. Never commit a real key.
ANTHROPIC_API_KEY=
