# Local Docker Web management configuration. Copying this file does not start the stack.
DOCKER_WEB_PORT=8765
DOCKER_WEB_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENSANDBOX_ALLOWED_HOSTS=api.anthropic.com
OPENSANDBOX_IDLE_TTL_SECONDS=300
OPENSANDBOX_SANDBOX_TIMEOUT_SECONDS=14400
OPENSANDBOX_WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_STALE_SECONDS=15

# Used only when the launcher is invoked with --claude. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional Data Agent integration. Keep all active Docker configuration in this
# file's local copy (.env.docker.local), not in generated .runtime/*.env files.
# Recognized DATA_AGENT_*, SQLBOT_* and STARROCKS_* settings are forwarded to
# API/Worker. For starrocks_poc, this is a HOST file path; the launcher mounts it
# read-only at /app/starrocks-manifest.json in API, Worker and migration services.
# DATA_AGENT_ENABLED=true
# DATA_AGENT_PROVIDER=starrocks_poc
# DATA_AGENT_SUBJECT=mock-user
# DATA_AGENT_STARROCKS_MANIFEST=/absolute/path/to/manifest.json
# DATA_AGENT_BROWSER_ORIGIN=http://127.0.0.1:8765
# DATA_AGENT_PUBLIC_BASE_URL=http://host.docker.internal:8765
# SQLBOT_BASE_URL=http://host.docker.internal:8000
# Supply matching SQLBOT_ADMIN_PASSWORD, SQLBOT_SECRET_KEY and STARROCKS_*
# connection settings locally. For service2 metadata, also set the existing
# DATA_AGENT_STARROCKS_METADATA_SOURCE and SQLBOT_CATALOG_* settings.
