    {
      "id": "space-order-record-alert",
      "request": "在上海分析空间，每天九点检查昨日未成交订单，提交金额超过一万元的逐条发给对应区经，带上订单明细。",
      "navigation": {
        "spaceRef": "space-current",
        "destination": "subscription"
      },
      "expected": {
        "ownershipScope": "space",
        "terminal": "reviewed-draft",
        "grain": "order",
        "pushMode": "record",
        "operator": "gt",
        "threshold": 10000,
        "dateExpression": "last_day",
        "dynamicEmployeeMustBeOutput": true,
        "includeDataCheck": false,
        "creates": 0
      },
      "batches": [
        [
          {
            "operation": "set_schedule",
            "frequency": "daily",
            "times": [
              "09:00"
            ]
          },
          {
            "operation": "set_send_rule",
            "sendRule": "conditional"
          },
          {
            "operation": "upsert_dataset_query",
            "datasetRef": "dataset-orders",
            "dimensionRefs": [
              "field-order",
              "field-manager"
            ],
            "metricRefs": [
              "field-amount"
            ],
            "filters": [
              {
                "fieldRef": "field-created",
                "operator": "eq",
                "valueExp": "last_day"
              },
              {
                "fieldRef": "field-status",
                "operator": "in",
                "valueRefs": [
                  "value-unclosed"
                ]
              }
            ]
          },
          {
            "operation": "set_finalize",
            "ruleName": "昨日未成交订单预警",
            "desiredStatus": "disabled"
          }
        ],
        [
          {
            "operation": "set_trigger_conditions",
            "queryRef": "query-orders",
            "conditions": [
              {
                "fieldRef": "field-amount",
                "operator": "gt",
                "values": [
                  10000
                ]
              }
            ],
            "logicalOperator": "and"
          },
          {
            "operation": "set_push_mode",
            "mode": "record",
            "queryRef": "query-orders"
          },
          {
            "operation": "set_recipients",
            "fieldRecipients": [
              {
                "queryRef": "query-orders",
                "fieldRef": "field-manager"
              }
            ]
          },
          {
            "operation": "set_content",
            "title": "昨日未成交订单预警",
            "includeDataTable": true,
            "dataTableQueryRef": "query-orders",
            "dataTableFieldRefs": [
              "field-order",
              "field-amount"
            ]
          }
        ]
      ]
    },
